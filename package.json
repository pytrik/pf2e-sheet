{
  "name": "pf2e-sheet",
  "version": "1.8.0",
  "description": "A single-page application for creating clean, readable Pathfinder 2nd Edition character sheets. The app compiles to a single HTML file for easy distribution and offline use.",
  "license": "MIT",
  "homepage": "https://pytrik.github.io/pf2e-sheet/",
  "repository": "github:pytrik/pf2e-sheet",
  "author": "pytrik",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^6.0.3"
  }
}
